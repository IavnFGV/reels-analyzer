# Rebuild the devcontainer after changing this value.
# Set to 0 to disable automatic `ollama serve` startup and model pulling.
OLLAMA_AUTOSTART=1
#
# Recommended CPU model:
# OLLAMA_PULL_MODEL=qwen2.5:3b
#
# Recommended GPU model:
# OLLAMA_PULL_MODEL=qwen2.5:7b
#
# Other examples:
# OLLAMA_PULL_MODEL=llama3.1:8b
# OLLAMA_PULL_MODEL=mistral:7b
OLLAMA_PULL_MODEL=qwen2.5:3b
